<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>oa_licalib</name>
  <version>0.1.0</version>
  <description>The oa_licalib package - Observability-Aware Intrinsic and Extrinsic Calibration of LiDAR-IMU Systems</description>
  
  <maintainer email="april@todo.todo">hkw</maintainer>
  <license>Apache-2.0</license>
  
  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <!-- Message generation dependencies -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  
  <!-- Core ROS2 dependencies -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>angles</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>ndt_omp</depend>
  <depend>ament_index_cpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>velodyne_msgs</depend>
  
  <!-- External dependencies -->
  <depend>eigen</depend>
  <depend>libopencv-dev</depend>
  <depend>yaml-cpp</depend>
  <depend>libpcl-all-dev</depend>
  
  <!-- Test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>